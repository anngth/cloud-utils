#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
ROOT_DIR="${SCRIPT_DIR:h}"
PYTHON_BIN="$ROOT_DIR/.venv/bin/python"
SOURCE_LIMIT=6105
SKM_COVERAGE_MIN=95

cd "$ROOT_DIR"

if ! command -v uv >/dev/null 2>&1; then
  print -u2 -r -- "❌ Missing required command: uv"
  exit 1
fi
if ! command -v npx >/dev/null 2>&1; then
  print -u2 -r -- "❌ Missing required command: npx"
  exit 1
fi

print -r -- "==> Syncing locked Python environment"
uv sync --locked
git diff --exit-code -- uv.lock
if [[ ! -x "$PYTHON_BIN" ]]; then
  print -u2 -r -- "❌ Missing project Python: $PYTHON_BIN"
  exit 1
fi

coverage_file=""
coverage_json_file=""
active_child_pid=0
child_may_be_starting=0
cleanup_coverage() {
  [[ -z "$coverage_file" ]] || rm -f -- "$coverage_file"
  [[ -z "$coverage_json_file" ]] || rm -f -- "$coverage_json_file"
}
forward_signal() {
  local signal_name="$1"
  local signal_status="$2"
  local child_pid="$active_child_pid"

  trap '' HUP INT TERM
  if (( child_pid == 0 && child_may_be_starting )); then
    child_pid="${!:-0}"
  fi
  active_child_pid=0
  child_may_be_starting=0
  if (( child_pid > 0 )); then
    kill -s "$signal_name" "$child_pid" 2>/dev/null || true
    wait "$child_pid" 2>/dev/null || true
  fi
  exit "$signal_status"
}
trap cleanup_coverage EXIT
trap 'forward_signal HUP 129' HUP
trap 'forward_signal INT 130' INT
trap 'forward_signal TERM 143' TERM

coverage_file="$(mktemp "${TMPDIR:-/tmp}/cloud-utils-verify.XXXXXX")"
coverage_json_file="$(mktemp "${TMPDIR:-/tmp}/cloud-utils-verify.XXXXXX")"

print -r -- "==> Running Python tests with coverage"
run_pytest() {
  local child_status=0

  child_may_be_starting=1
  unsetopt BG_NICE
  (
    trap - HUP INT TERM
    export COVERAGE_FILE="$coverage_file"
    exec "$PYTHON_BIN" -m pytest \
      --cov=shared --cov=twofa --cov=git_tools --cov=skills_manager
  ) &
  active_child_pid=$!
  child_may_be_starting=0
  wait "$active_child_pid" || child_status=$?
  active_child_pid=0
  return "$child_status"
}
if run_pytest; then
  :
else
  pytest_status=$?
  exit "$pytest_status"
fi
COVERAGE_FILE="$coverage_file" "$PYTHON_BIN" -m coverage report \
  '--include=*/skills_manager/*.py'
COVERAGE_FILE="$coverage_file" "$PYTHON_BIN" -m coverage json \
  '--include=*/skills_manager/*.py' -q -o "$coverage_json_file"
"$PYTHON_BIN" - "$coverage_json_file" "$SKM_COVERAGE_MIN" <<'PY'
import json
import sys
from pathlib import Path


totals = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))["totals"]
covered_lines = int(totals["covered_lines"])
num_statements = int(totals["num_statements"])
minimum = int(sys.argv[2])

if num_statements == 0:
    print(
        "❌ skills_manager statement coverage has no statements; "
        f"minimum is {minimum}%",
        file=sys.stderr,
    )
    raise SystemExit(1)

if covered_lines * 100 < num_statements * minimum:
    percent = covered_lines * 100 / num_statements
    print(
        f"❌ skills_manager statement coverage is "
        f"{covered_lines}/{num_statements} ({percent:.4f}%); "
        f"minimum is {minimum}%",
        file=sys.stderr,
    )
    raise SystemExit(1)
PY

print -r -- "==> Checking production Python source budget"
python_lines="$(
  find mac_scripts/functions/shared mac_scripts/functions/twofa \
    mac_scripts/functions/git_tools mac_scripts/functions/skills_manager \
    -type f -name '*.py' \
    ! -path '*/tests/*' -print0 \
    | xargs -0 wc -l \
    | tail -n 1 \
    | awk '{print $1}'
)"
if (( python_lines > SOURCE_LIMIT )); then
  print -u2 -r -- "❌ Production Python source is $python_lines lines; limit is $SOURCE_LIMIT"
  exit 1
fi
print -r -- "    Production Python: $python_lines/$SOURCE_LIMIT lines"

print -r -- "==> Checking diff hygiene"
git diff --check

print -r -- "✅ Verification complete"
