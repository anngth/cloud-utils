#!/bin/zsh
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PYTHON_BIN="$SCRIPT_DIR/../.venv/bin/python"
if [[ ! -x "$PYTHON_BIN" ]]; then
  print -P "%F{red}❌ bud requires the project environment; run 'uv sync --locked' in ${SCRIPT_DIR:h}%f" >&2
  exit 1
fi
exec "$PYTHON_BIN" "$SCRIPT_DIR/functions/brew-desired-update/__main__.py" "$@"
